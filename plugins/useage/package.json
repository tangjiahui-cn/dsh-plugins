{
  "name": "@tjhaaa/dsh-plugin-useage",
  "version": "0.1.0",
  "type": "module",
  "description": "在会话标题行展示今日与累计花费、token 与账户余额。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangjiahui-cn/dsh-plugins.git",
    "directory": "plugins/useage"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "usage",
    "cost"
  ],
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./projection": "./projection.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "projection.js",
    "today.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "icon.svg",
    "assets"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "check": "node --check index.js && node --check projection.js && node --check today.js && node --check client.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "zod": "^4.6.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
